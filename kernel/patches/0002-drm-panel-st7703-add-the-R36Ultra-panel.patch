From f261b2ce6bc29e1eaab62fada86f0b43e93fe3d9 Mon Sep 17 00:00:00 2001
From: rei_512_ <me@deltav-lab.org>
Date: Wed, 30 Sep 2026 15:02:28 +0900
Subject: [PATCH 2/3] drm/panel: st7703: add the R36Ultra panel

Add the 720x720 panel of the R36Ultra handheld (RK3326) with the mode and
the init sequence of the stock BSP device tree. The panel descriptor can
now optionally send the init sequence from prepare(), while the DSI host
is still in command mode, and set the reset hold and post display-on
delays.
---
 drivers/gpu/drm/panel/panel-sitronix-st7703.c | 139 +++++++++++++++++-
 1 file changed, 136 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-sitronix-st7703.c b/drivers/gpu/drm/panel/panel-sitronix-st7703.c
index 6c348fe28..394c70c7c 100644
--- a/drivers/gpu/drm/panel/panel-sitronix-st7703.c
+++ b/drivers/gpu/drm/panel/panel-sitronix-st7703.c
@@ -70,6 +70,15 @@ struct st7703_panel_desc {
 	unsigned long mode_flags;
 	enum mipi_dsi_pixel_format format;
 	void (*init_sequence)(struct mipi_dsi_multi_context *dsi_ctx);
+	/* Optional, 0 = driver defaults: reset held low / after display on */
+	unsigned int reset_hold_ms;
+	unsigned int post_display_on_ms;
+	/*
+	 * Send the init sequence from prepare(), i.e. while the DSI host is
+	 * still in command mode (LP-11, no video), as the vendor U-Boot/BSP
+	 * do. Default (false) sends it from enable() with video running.
+	 */
+	bool init_in_prepare;
 };
 
 static inline struct st7703 *panel_to_st7703(struct drm_panel *panel)
@@ -673,9 +682,8 @@ static const struct st7703_panel_desc gameforcechi_desc = {
 	.init_sequence = gameforcechi_init_sequence,
 };
 
-static int st7703_enable(struct drm_panel *panel)
+static int st7703_send_init(struct st7703 *ctx)
 {
-	struct st7703 *ctx = panel_to_st7703(panel);
 	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
 	struct mipi_dsi_multi_context dsi_ctx = {.dsi = dsi};
 
@@ -687,6 +695,8 @@ static int st7703_enable(struct drm_panel *panel)
 	mipi_dsi_msleep(&dsi_ctx, 120);
 
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	if (ctx->desc->post_display_on_ms)
+		mipi_dsi_msleep(&dsi_ctx, ctx->desc->post_display_on_ms);
 
 	if (!dsi_ctx.accum_err)
 		dev_dbg(ctx->dev, "Panel init sequence done\n");
@@ -694,6 +704,16 @@ static int st7703_enable(struct drm_panel *panel)
 	return dsi_ctx.accum_err;
 }
 
+static int st7703_enable(struct drm_panel *panel)
+{
+	struct st7703 *ctx = panel_to_st7703(panel);
+
+	if (ctx->desc->init_in_prepare)
+		return 0;
+
+	return st7703_send_init(ctx);
+}
+
 static int st7703_disable(struct drm_panel *panel)
 {
 	struct st7703 *ctx = panel_to_st7703(panel);
@@ -743,11 +763,25 @@ static int st7703_prepare(struct drm_panel *panel)
 	}
 
 	/* Give power supplies time to stabilize before deasserting reset. */
-	usleep_range(10000, 20000);
+	if (ctx->desc->reset_hold_ms)
+		msleep(ctx->desc->reset_hold_ms);
+	else
+		usleep_range(10000, 20000);
 
 	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
 	usleep_range(15000, 20000);
 
+	if (ctx->desc->init_in_prepare) {
+		ret = st7703_send_init(ctx);
+		if (ret) {
+			/* prepare failed: DRM will not call unprepare */
+			gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+			regulator_disable(ctx->iovcc);
+			regulator_disable(ctx->vcc);
+			return ret;
+		}
+	}
+
 	return 0;
 }
 
@@ -914,11 +948,110 @@ static void st7703_remove(struct mipi_dsi_device *dsi)
 	st7703_debugfs_remove(ctx);
 }
 
+static void r36ultra_init_sequence(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	/* BSP: reset-delay-ms = 120 before the first command */
+	mipi_dsi_msleep(dsi_ctx, 120);
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETEXTC, 0xf1, 0x12, 0x83);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETAPID, 0x00, 0x00, 0x00,
+				     0xda, 0x80);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETDISP, 0x3c, 0x12, 0x30);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETRGBIF, 0x10, 0x10, 0x28,
+				     0x28, 0x03, 0xff, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETCYC, 0x80);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETBGP, 0x0a, 0x0a);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETVCOM, 0x97, 0x97);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETPOWER_EXT, 0x26, 0x22,
+				     0xf0, 0x13);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETMIPI, 0x33, 0x81, 0x05,
+				     0xf9, 0x0e, 0x0e, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x44, 0x25, 0x00, 0x90, 0x0a, 0x00, 0x00, 0x01, 0x4f, 0x01, 0x00,
+				     0x00, 0x37);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETVDC, 0x47);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_UNKNOWN_BF, 0x02, 0x11,
+				     0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETSCR, 0x73, 0x73, 0x50,
+				     0x50, 0x00, 0x00, 0x12, 0x70, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETPOWER, 0x25, 0x00, 0x32,
+				     0x32, 0x77, 0xe4, 0xff, 0xff, 0xcc, 0xcc, 0x77, 0x77);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETECO, 0x82, 0x00, 0xbf,
+				     0xff, 0x00, 0xff);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETIO, 0xb8, 0x00, 0x0a,
+				     0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETCABC, 0x10, 0x40, 0x1e,
+				     0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETPANEL, 0x0b);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETGAMMA, 0x00, 0x0b, 0x10,
+				     0x2c, 0x3d, 0x3f, 0x42, 0x3a, 0x07, 0x0d, 0x0f, 0x13, 0x15, 0x13,
+				     0x14, 0x0f, 0x16, 0x00, 0x0b, 0x10, 0x2c, 0x3d, 0x3f, 0x42, 0x3a,
+				     0x07, 0x0d, 0x0f, 0x13, 0x15, 0x13, 0x14, 0x0f, 0x16);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETEQ, 0x07, 0x07, 0x0b,
+				     0x0b, 0x0b, 0x0b, 0x00, 0x00, 0x00, 0x00, 0xff, 0x00, 0xc0, 0x10);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETGIP1, 0xc8, 0x10, 0x0a,
+				     0x00, 0x00, 0x80, 0x81, 0x12, 0x31, 0x23, 0x4f, 0x86, 0xa0, 0x00,
+				     0x47, 0x08, 0x00, 0x00, 0x0c, 0x00, 0x00, 0x00, 0x00, 0x00, 0x0c,
+				     0x00, 0x00, 0x00, 0x98, 0x02, 0x8b, 0xaf, 0x46, 0x02, 0x88, 0x88,
+				     0x88, 0x88, 0x88, 0x98, 0x13, 0x8b, 0xaf, 0x57, 0x13, 0x88, 0x88,
+				     0x88, 0x88, 0x88, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETGIP2, 0x97, 0x0c, 0x09,
+				     0x09, 0x09, 0x78, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x9f, 0x31,
+				     0x8b, 0xa8, 0x31, 0x75, 0x88, 0x88, 0x88, 0x88, 0x88, 0x9f, 0x20,
+				     0x8b, 0xa8, 0x20, 0x64, 0x88, 0x88, 0x88, 0x88, 0x88, 0x23, 0x00,
+				     0x00, 0x02, 0x71, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x40, 0x80, 0x81, 0x00,
+				     0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_UNKNOWN_EF, 0xff, 0xff,
+				     0x01);
+	/* BSP: SLPOUT, then 250 ms (the driver sends it again and waits 120 ms) */
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 250);
+	/* BSP: DISPON + 50 ms is done by st7703_enable() */
+}
+
+/*
+ * R36Ultra (RK3326 handheld). Panel timing and init sequence taken from the
+ * stock BSP device tree (rk3326-evb-lp3-v12-linux.dtb, panel@0), which also
+ * matches what the vendor U-Boot programs: 45 MHz, H 720/140/80/140,
+ * V 720/20/4/20.
+ */
+static const struct drm_display_mode r36ultra_mode = {
+	.hdisplay	= 720,
+	.hsync_start	= 720 + 140,
+	.hsync_end	= 720 + 140 + 80,
+	.htotal		= 720 + 140 + 80 + 140,
+	.vdisplay	= 720,
+	.vsync_start	= 720 + 20,
+	.vsync_end	= 720 + 20 + 4,
+	.vtotal		= 720 + 20 + 4 + 20,
+	.clock		= 45000,
+	.flags		= DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+	/* width-mm/height-mm as declared by the BSP (the panel is square) */
+	.width_mm	= 153,
+	.height_mm	= 85,
+};
+
+static const struct st7703_panel_desc r36ultra_desc = {
+	.mode = &r36ultra_mode,
+	.lanes = 4,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_MODE_LPM,
+	.format = MIPI_DSI_FMT_RGB888,
+	.init_sequence = r36ultra_init_sequence,
+	/* BSP/U-Boot: reset-delay-ms = 120, enable-delay-ms = 120 */
+	.reset_hold_ms = 120,
+	.post_display_on_ms = 120,
+	/* BSP panel-simple / U-Boot: init sequence in prepare, before video */
+	.init_in_prepare = true,
+};
+
 static const struct of_device_id st7703_of_match[] = {
 	{ .compatible = "anbernic,rg353v-panel-v2", .data = &rg353v2_desc },
 	{ .compatible = "gameforce,chi-panel", .data = &gameforcechi_desc },
 	{ .compatible = "powkiddy,rgb10max3-panel", .data = &rgb10max3_panel_desc },
 	{ .compatible = "powkiddy,rgb30-panel", .data = &rgb30panel_desc },
+	{ .compatible = "rgameconsole,r36ultra-panel", .data = &r36ultra_desc },
 	{ .compatible = "rocktech,jh057n00900", .data = &jh057n00900_panel_desc },
 	{ .compatible = "xingbangda,xbd599", .data = &xbd599_desc },
 	{ /* sentinel */ }
-- 
